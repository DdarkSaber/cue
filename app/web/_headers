/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: CUE_API_ORIGIN https://s4.anilist.co; connect-src 'self' CUE_API_ORIGIN https://graphql.anilist.co https://s4.anilist.co; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

# Entry points are not content-hashed: always revalidate so a deploy is picked up.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
# Large, rarely changing binaries and static art.
/sqlite3.wasm
  Cache-Control: public, max-age=604800
/drift_worker.js
  Cache-Control: public, max-age=604800
/canvaskit/*
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=604800
/favicon.png
  Cache-Control: public, max-age=604800
